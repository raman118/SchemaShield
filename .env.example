# Copy to .env and replace these local-only values before enabling sandbox execution.
CONTROL_DB_PASSWORD=change-me-local-only
SCHEMASHIELD_DATABASE_URL=postgresql+psycopg://schemashield:change-me-local-only@localhost:5432/schemashield
SCHEMASHIELD_API_TOKEN=local-development-token-change-me
SCHEMASHIELD_CORS_ORIGIN=http://localhost:3000
SCHEMASHIELD_SANDBOX_ENABLED=false
